;; AI-assisted adaptation of jank's MPL-2.0 example; see README.md.
(ns org.jank-lang.example.flappy-bird
  (:include "raylib.h"
            "raygui.h"))

(def max-tube-columns 100)
(def tube-width 80)
(def bird-speed 2)
(def bird-size 20)
(def screen-width 800)
(def screen-height 450)

(def default-state {:mode :main-menu ; :main-menu, :playing, :paused, :game-over
                    :bird {:x 0
                           :y 0}
                    :columns []
                    :score 0
                    :high-score 0})

(defn start-game [state]
  (let [bird-y (- (/ screen-height 2) bird-size)
        columns (mapv (fn [tube-idx]
                        (let [x (int (+ (/ screen-width 2) (* 280 tube-idx)))
                              y (int (- (cpp/GetRandomValue 0 120)))]
                          {:bottom {:x x
                                    :y y
                                    :width tube-width
                                    :height 255}
                           :top {:x x
                                 :y (- (+ y 600) 255)
                                 :width tube-width
                                 :height 255}
                           :active? true}))
                    (range max-tube-columns))]
    (-> default-state
        (assoc :bird {:x 80
                      :y bird-y})
        (assoc :columns columns)
        (assoc :high-score (:high-score state)))))

(defn flapping? []
  (or (cpp/IsKeyDown cpp/KEY_SPACE)
      (cpp/IsMouseButtonDown cpp/MOUSE_BUTTON_LEFT)))

(defn step-frame [state]
  (cond
    (= :main-menu (:mode state))
    (if (or (cpp/IsKeyPressed cpp/KEY_SPACE)
            (cpp/IsMouseButtonPressed cpp/MOUSE_BUTTON_LEFT))
      (assoc state :mode :playing)
      state)

    (= :game-over (:mode state))
    (if (cpp/IsKeyPressed cpp/KEY_ENTER)
      (start-game state)
      state)

    (and (cpp/IsKeyPressed (int \P)) (contains? #{:playing :paused} (:mode state)))
    (update state :mode {:paused :playing
                         :playing :paused})

    (= :paused (:mode state))
    state

    :else
    (let [state (update state
                        :columns
                        (fn [cols]
                          (mapv (fn [col]
                                  (-> col
                                      (update-in [:bottom :x] - bird-speed)
                                      (update-in [:top :x] - bird-speed)))
                                cols)))

          state (if (flapping?)
                  (update-in state [:bird :y] - 3)
                  (update-in state [:bird :y] + 1))
          bird-x (int (get-in state [:bird :x]))
          bird-y (int (get-in state [:bird :y]))
          bird-size (int bird-size)
          bird-rec (cpp/Rectangle (- bird-x bird-size) (- bird-y bird-size)
                                  (* bird-size 2) (* bird-size 2))
          state (reduce (fn [state [{:keys [bottom top active?]} col-idx]]
                            (let [bottom-rec (cpp/Rectangle (int (:x bottom)) (int (:y bottom))
                                                            (int (:width bottom)) (int (:height bottom)))
                                  top-rec (cpp/Rectangle (int (:x top)) (int (:y top))
                                                         (int (:width top)) (int (:height top)))]
                              (cond
                                (or (cpp/CheckCollisionRecs bird-rec bottom-rec)
                                    (cpp/CheckCollisionRecs bird-rec top-rec))
                                (reduced (assoc state :mode :game-over))

                                (and active? (cpp/< (.-x bottom-rec) bird-x))
                                (let [score (+ 100 (:score state))
                                      state (-> (assoc state :score score)
                                                (assoc-in [:columns col-idx :active?] false))]
                                  (if (< (:high-score state) score)
                                    (assoc state :high-score score)
                                    state))

                                :else
                                state)))
                            state
                            (map vector (:columns state) (range)))]
      state)))

(declare draw-bird!)

(defn draw-main-menu! [state]
  (let [t (mod (long (* 30 (cpp/GetTime))) 60)]
    (draw-bird! (assoc-in state [:bird :y] (+ 180 (min t (- 60 t))))))
  (let [new-game-width 200
        new-game-height 60
        changes (volatile! [])]
    (when-not (zero? (cpp/GuiButton (cpp/Rectangle (int (- (/ screen-width 2) (/ new-game-width 2)))
                                                   (int (- (/ screen-height 2) (/ new-game-height 2)))
                                                   (int new-game-width)
                                                   (int new-game-height))
                                    "New game"))
      (vswap! changes conj #(assoc % :mode :playing)))

    (cpp/DrawText (cpp/TextFormat "HIGHEST %04i" (:high-score state)) 20 70 20 (cpp/GetColor 0xff6ec7ff))
    (reduce #(%2 %1) state @changes)))

(defn draw-bird! [state]
  (let [bird-x (int (get-in state [:bird :x]))
        bird-y (int (get-in state [:bird :y]))
        wings-down? (flapping?)
        wing-span (int (- bird-size 4))
        wing-control-offset 10
        wing-tip-y (if wings-down?
                     (+ bird-y 14)
                     (- bird-y 6))
        wing-peak-y (if wings-down?
                      (- bird-y 2)
                      (- bird-y 20))
        wing-center-y (+ bird-y 5)
        wing-thickness 8
        bird-color (cpp/GetColor 0x00f0ffff)]
    (cpp/DrawSplineSegmentBezierQuadratic (cpp/Vector2 (- bird-x wing-span) wing-tip-y)
                                          (cpp/Vector2 (- bird-x wing-control-offset) wing-peak-y)
                                          (cpp/Vector2 bird-x wing-center-y)
                                          wing-thickness
                                          bird-color)
    (cpp/DrawSplineSegmentBezierQuadratic (cpp/Vector2 bird-x wing-center-y)
                                          (cpp/Vector2 (+ bird-x wing-control-offset) wing-peak-y)
                                          (cpp/Vector2 (+ bird-x wing-span) wing-tip-y)
                                          wing-thickness
                                          bird-color)
    (cpp/DrawCircle (- bird-x wing-span) wing-tip-y (int (/ wing-thickness 2)) bird-color)
    (cpp/DrawCircle (+ bird-x wing-span) wing-tip-y (int (/ wing-thickness 2)) bird-color)
    (cpp/DrawCircle bird-x wing-center-y (int (/ wing-thickness 2)) bird-color)))

(defn draw-frame! [state]
  (cpp/DrawRectangleGradientV 0
                              0
                              screen-width
                              screen-height
                              (cpp/GetColor 0x12072fff)
                              (cpp/GetColor 0x2b0d45ff))


  (if (= :main-menu (:mode state))
    (draw-main-menu! state)
    (do
      (draw-bird! state)
      (doseq [{:keys [bottom top]} (:columns state)]
        (cpp/DrawRectangle (:x bottom)
                           (:y bottom)
                           (:width bottom)
                           (:height bottom)
                           (cpp/GetColor 0x2d1b4eff))
        (cpp/DrawRectangleLines (:x bottom) (:y bottom) (:width bottom) (:height bottom) (cpp/GetColor 0xff2bd6ff))
        (cpp/DrawRectangle (:x top)
                           (:y top)
                           (:width top)
                           (:height top)
                           (cpp/GetColor 0x241542ff))
        (cpp/DrawRectangleLines (:x top) (:y top) (:width top) (:height top) (cpp/GetColor 0xff2bd6ff))

        (cpp/DrawText (cpp/TextFormat "%04i" (:score state)) 20 20 40 (cpp/GetColor 0xffe94fff))
        (cpp/DrawText (cpp/TextFormat "HIGHEST %04i" (:high-score state)) 20 70 20 (cpp/GetColor 0xff6ec7ff))

        (when (= :paused (:mode state))
          (cpp/DrawText "GAME PAUSED"
                        (- (/ screen-width 2) (/ (cpp/MeasureText "GAME PAUSED" 40) 2))
                        (- (/ screen-height 2) 40)
                        40
                        (cpp/GetColor 0x00f0ffff))))

      (when (= :game-over (:mode state))
        (cpp/DrawText "PRESS [ENTER] TO PLAY AGAIN"
                      (- (/ screen-width 2) (/ (cpp/MeasureText "PRESS [ENTER] TO PLAY AGAIN" 20) 2))
                      (/ screen-height 2)
                      20
                      (cpp/GetColor 0xff2bd6ff)))
      state)))

(def global-state (atom default-state))

(defn frame []
  (let [state (step-frame @global-state)]
    (cpp/BeginDrawing)
    (reset! global-state (draw-frame! state))
    (cpp/EndDrawing))
  nil)

(defn -main [& args]
  (cpp/InitWindow screen-width screen-height "janky bird")
  #?(:native (cpp/SetTargetFPS 60))
  (reset! global-state (start-game default-state))
  (assert (= 100 (count (:columns @global-state))))
  (assert (= 80 (get-in @global-state [:bird :x])))
  (assert (= :main-menu (:mode @global-state)))
  (println "flappy-bird: rules passed")
  (println "flappy-bird: initialized")
  #?(:native
     (do
       (while (and (cpp/! (cpp/WindowShouldClose))
                   (or (empty? args) (< (cpp/GetTime) 2)))
         (frame))
       (cpp/CloseWindow)
       (println "flappy-bird: native loop completed"))))

(comment
  (def fut (future (-main))))
