;; AI-assisted coverage probe for the local Binaryen memory64 stack patch.
(module
  (import "env" "collect" (func $collect (result i32)))
  (memory (export "memory") i64 1)
  (global $__stack_pointer (export "sp") (mut i64) (i64.const 4096))
  (type $collector (func (result i32)))
  (table 1 funcref)
  (elem (i32.const 0) $collect)
  (func (export "direct") (param $value i64) (result i64)
    (drop (call $collect))
    (local.get $value))
  (func (export "indirect") (param $value i64) (result i64)
    (drop (call_indirect (type $collector) (i32.const 0)))
    (local.get $value))
  (func (export "early") (param $value i64) (result i64)
    (drop (call $collect))
    (return (local.get $value)))
  (func (export "nonpointer") (param $value i32) (result i32)
    (drop (call $collect))
    (local.get $value))
  (func $consume (param i64 i32) (result i64) (local.get 0))
  (func (export "operand") (param $value i64) (result i64)
    (call $consume (local.get $value) (call $collect)))
)
