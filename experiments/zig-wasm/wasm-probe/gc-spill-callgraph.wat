;; AI-assisted fixture for the private gc-spill-pointers Binaryen pass.
(module
  (import "env" "GC_gcollect" (func $GC_gcollect))
  (import "env" "now" (func $now (result f64)))
  (import "env" "callback" (func $callback))
  (memory (export "memory") i64 1)
  (global $__stack_pointer (export "sp") (mut i64) (i64.const 4096))
  (type $leaf_type (func (param i64) (result i64)))
  (type $alloc_type (func (param i64 i64) (result i64)))
  (table 2 funcref)
  (elem (i32.const 0) $leaf_target $GC_malloc)
  (func $GC_malloc (param $size i64) (param $flags i64) (result i64)
    (call $GC_gcollect)
    (local.get $size))
  (func $fib (export "fib") (param $n i64) (result i64)
    (drop (call $now))
    (if (result i64) (i64.lt_u (local.get $n) (i64.const 2))
      (then (local.get $n))
      (else (i64.add (call $fib (i64.sub (local.get $n) (i64.const 1)))
                     (call $fib (i64.sub (local.get $n) (i64.const 2)))))))
  (func $leaf_target (param $value i64) (result i64)
    (i64.add (local.get $value) (i64.const 1)))
  (func $leaf_indirect (export "leaf_indirect") (param $p i64) (result i64)
    (drop (call_indirect (type $leaf_type) (local.get $p) (i32.const 0)))
    (local.get $p))
  (func $alloc_indirect (export "alloc_indirect") (param $p i64) (result i64)
    (drop (call_indirect (type $alloc_type) (i64.const 8) (i64.const 0) (i32.const 1)))
    (local.get $p))
  (func $mixed (export "mixed") (param $p i64) (result i64)
    (drop (call $fib (local.get $p)))
    (drop (call $GC_malloc (i64.const 8) (i64.const 0)))
    (drop (call $fib (local.get $p)))
    (local.get $p))
  (func $via_callback (export "via_callback") (param $p i64) (result i64)
    (call $callback)
    (local.get $p))
  (func $via_caller (export "via_caller") (param $p i64) (result i64)
    (drop (call $via_callback (local.get $p)))
    (local.get $p))
)
