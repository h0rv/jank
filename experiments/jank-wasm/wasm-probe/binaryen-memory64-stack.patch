+struct GCSpillPointers : public Pass {
+  bool addsEffects() override { return true; }
+  bool invalidatesDWARF() override { return true; }
+
+  struct Calls {
+    std::unordered_set<Name> direct;
+    std::unordered_set<HeapType> indirect;
+    bool unknown = false;
+  };
+
+  std::vector<std::string> patterns(const std::string& key) {
+    std::vector<std::string> out;
+    for (auto& item : String::Split(getArgumentOrDefault(key, ""), ",")) {
+      if (!item.empty()) {
+        out.push_back(item);
+      }
+    }
+    return out;
+  }
+
+  static bool matches(const std::vector<std::string>& patterns,
+                      const std::string& value) {
+    for (auto& pattern : patterns) {
+      if (String::wildcardMatch(pattern, value)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  void run(Module* module) override {
+    auto collectors = patterns("gc-spill-pointers-collectors");
+    auto safeImports = patterns("gc-spill-pointers-safe-imports");
+    if (collectors.empty()) {
+      Fatal() << "gc-spill-pointers: pass gc-spill-pointers-collectors";
+    }
+
+    ModuleUtils::ParallelFunctionAnalysis<Calls> analysis(
+      *module, [&](Function* func, Calls& calls) {
+        if (func->imported()) {
+          return;
+        }
+        for (auto* call : FindAll<Call>(func->body).list) {
+          calls.direct.insert(call->target);
+        }
+        for (auto* call : FindAll<CallIndirect>(func->body).list) {
+          calls.indirect.insert(call->heapType);
+        }
+        calls.unknown = !FindAll<CallRef>(func->body).list.empty();
+      });
+
+    std::unordered_map<HeapType, std::vector<Name>> tableFuncs;
+    std::unordered_set<Name> inTable;
+    ElementUtils::iterAllElementFunctionNames(module, [&](Name name) {
+      if (inTable.insert(name).second) {
+        tableFuncs[module->getFunction(name)->type.getHeapType()].push_back(
+          name);
+      }
+    });
+
+    std::unordered_map<Name, std::vector<Name>> directCallers;
+    std::unordered_map<HeapType, std::vector<Name>> indirectCallers;
+    std::unordered_set<Name> mayCollect;
+    std::unordered_set<HeapType> collectingTypes;
+    std::vector<Name> work;
+    auto mark = [&](Name name) {
+      if (mayCollect.insert(name).second) {
+        work.push_back(name);
+      }
+    };
+    Index seeds = 0;
+    for (auto& [func, calls] : analysis.map) {
+      if (matches(collectors, func->name.toString())) {
+        seeds++;
+        mark(func->name);
+      } else if (func->imported() &&
+                 !matches(safeImports,
+                          func->module.toString() + "." +
+                            func->base.toString())) {
+        mark(func->name);
+      }
+      if (calls.unknown) {
+        mark(func->name);
+      }
+      for (auto callee : calls.direct) {
+        directCallers[callee].push_back(func->name);
+      }
+      for (auto type : calls.indirect) {
+        indirectCallers[type].push_back(func->name);
+        if (!tableFuncs.contains(type)) {
+          collectingTypes.insert(type);
+          mark(func->name);
+        }
+      }
+    }
+    if (seeds == 0) {
+      Fatal() << "gc-spill-pointers: no function matches the collector "
+                 "patterns (are function names preserved?)";
+    }
+    while (!work.empty()) {
+      auto name = work.back();
+      work.pop_back();
+      if (auto it = directCallers.find(name); it != directCallers.end()) {
+        for (auto caller : it->second) {
+          mark(caller);
+        }
+      }
+      if (inTable.contains(name)) {
+        auto type = module->getFunction(name)->type.getHeapType();
+        if (collectingTypes.insert(type).second) {
+          if (auto it = indirectCallers.find(type);
+              it != indirectCallers.end()) {
+            for (auto caller : it->second) {
+              mark(caller);
+            }
+          }
+        }
+      }
+    }
+
+    std::unordered_set<Name> noCollectFuncs;
+    std::unordered_set<HeapType> noCollectTypes;
+    PassUtils::FuncSet relevant;
+    Index defined = 0;
+    std::vector<std::string> skipped;
+    for (auto& func : module->functions) {
+      if (mayCollect.contains(func->name)) {
+        if (!func->imported()) {
+          defined++;
+          relevant.insert(func.get());
+        }
+      } else {
+        noCollectFuncs.insert(func->name);
+        if (!func->imported()) {
+          defined++;
+          skipped.push_back(func->name.toString());
+        }
+      }
+    }
+    for (auto& [type, names] : tableFuncs) {
+      if (!collectingTypes.contains(type)) {
+        noCollectTypes.insert(type);
+      }
+    }
+    std::cerr << "gc-spill-pointers: defined-functions=" << defined
+              << " transformed=" << relevant.size()
+              << " skipped=" << skipped.size() << " seeds=" << seeds
+              << " indirect-types=" << tableFuncs.size()
+              << " non-collecting-indirect-types=" << noCollectTypes.size()
+              << "\n";
+    auto report = getArgumentOrDefault("gc-spill-pointers-report", "");
+    if (!report.empty()) {
+      std::sort(skipped.begin(), skipped.end());
+      std::ofstream out(report);
+      for (auto& name : skipped) {
+        out << name << "\n";
+      }
+    }
+
+    PassUtils::FilteredPassRunner runner(module, relevant, getPassOptions());
+    runner.add("flatten");
+    runner.add(
+      std::make_unique<SpillPointers>(&noCollectFuncs, &noCollectTypes));
+    runner.setIsNested(true);
+    runner.run();
+  }
+};
+
 Pass* createSpillPointersPass() { return new SpillPointers(); }
 
+Pass* createGCSpillPointersPass() { return new GCSpillPointers(); }
+
 } // namespace wasm
